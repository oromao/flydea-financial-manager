generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                   @id @default(uuid())
  email                 String                   @unique
  password              String
  role                  String                   @default("MEMBER")
  name                  String?
  avatarUrl             String?
  resetToken            String?
  resetTokenExpires     DateTime?
  createdAt             DateTime                 @default(now())
  accounts              Account[]
  auditLogs             AuditLog[]
  budgets               Budget[]
  categories            Category[]
  recurrences           Recurrence[]
  tags                  Tag[]
  transactions          Transaction[]
  notifications         Notification[]
  notificationPreference NotificationPreference?
  approvalsRequested    ApprovalRequest[]       @relation("ApprovalsRequested")
  approvalsReviewed     ApprovalRequest[]       @relation("ApprovalsReviewed")
  invoices              Invoice[]
  revenues              Revenue[]
  cashflowWeekly        CashflowWeekly[]
  importedDocuments    ImportedDocument[]
  documentImportAttempts DocumentImportAttempt[]
  copilotConversations  CopilotConversation[]
  aiAgents              AIAgent[]
  intelligence          UserIntelligence?
  insights              Insight[]
  predictions           Prediction[]
  behavioralLogs        UserBehavioralLog[]
  webhooks              Webhook[]
}

model Category {
  id           String        @id @default(uuid())
  name         String
  type         String
  createdAt    DateTime      @default(now())
  userId       String?
  budgets      Budget[]
  user         User?         @relation(fields: [userId], references: [id])
  recurrences  Recurrence[]
  transactions Transaction[]
  revenues     Revenue[]

  @@unique([name, userId])
}

model Account {
  id           String        @id @default(uuid())
  name         String
  type         String
  balance      Float         @default(0)
  color        String?
  isActive     Boolean       @default(true)
  userId       String
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id            String           @id @default(uuid())
  type          String
  description   String
  amount        Float
  date          DateTime
  dueDate       DateTime?
  paidAt        DateTime?
  amountPaid    Float            @default(0)
  recurrenceId  String?
  recurrenceDate DateTime?
  observations  String?
  frequency     String           @default("NONE")
  paymentStatus String           @default("PENDING")
  attachmentUrl String?
  blobUrl       String?
  status        String           @default("CONFIRMED")
  userId        String
  categoryId    String
  accountId     String?
  createdAt     DateTime         @default(now())
  account       Account?         @relation(fields: [accountId], references: [id])
  category      Category         @relation(fields: [categoryId], references: [id])
  user          User             @relation(fields: [userId], references: [id])
  tags          TransactionTag[]
  importedDocumentId String?
}

model Tag {
  id           String           @id @default(uuid())
  name         String
  color        String           @default("#3B82F6")
  userId       String
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id])
  transactions TransactionTag[]

  @@unique([name, userId])
}

model TransactionTag {
  transactionId String
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
}

model Budget {
  id         String   @id @default(uuid())
  categoryId String
  userId     String
  amount     Float
  period     String   @default("MONTHLY")
  alertAt    Float    @default(80)
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model Recurrence {
  id          String    @id @default(uuid())
  description String
  amount      Float
  type        String    @default("EXPENSE")
  frequency   String
  startDate   DateTime
  nextDate    DateTime?
  dayOfMonth  Int?
  categoryId  String
  userId      String
  createdAt   DateTime  @default(now())
  isActive    Boolean   @default(true)
  category    Category  @relation(fields: [categoryId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  details   String?
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  message       String
  type          String
  relatedId     String?
  relatedType   String?
  metadata      Json?
  read          Boolean  @default(false)
  readAt        DateTime?
  createdAt     DateTime @default(now())
  expiresAt     DateTime?

  @@index([userId])
  @@index([createdAt])
}

model NotificationPreference {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled     Boolean @default(true)
  inAppEnabled     Boolean @default(true)
  transactionsOn   Boolean @default(true)
  budgetAlertsOn   Boolean @default(true)
  importsOn        Boolean @default(true)
  remindersOn      Boolean @default(true)
}

model ApprovalRequest {
  id          String   @id @default(cuid())
  action      String
  entity      String
  entityId    String
  payload     Json?
  status      String   @default("PENDING")
  reason      String?
  requestedById String
  reviewedById String?
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  requestedBy User     @relation("ApprovalsRequested", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User?    @relation("ApprovalsReviewed", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([entity, entityId])
}

model Invoice {
  id                String                @id @default(uuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceNumber     String
  clientName        String
  clientEmail       String?
  description       String?
  totalAmount       Float
  emissionDate      DateTime
  dueDate           DateTime?
  status            String                @default("EMITTED")
  paymentMethod     String?
  observations      String?
  installments      InvoiceInstallment[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([userId, invoiceNumber])
  @@index([userId, emissionDate])
  @@index([userId, status])
}

model InvoiceInstallment {
  id              String    @id @default(uuid())
  invoiceId       String
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  installmentNumber Int
  amount          Float
  dueDate         DateTime
  status          String    @default("PENDING")
  paidAt          DateTime?
  paidAmount      Float?
  createdAt       DateTime  @default(now())

  @@unique([invoiceId, installmentNumber])
  @@index([invoiceId, dueDate])
  @@index([status])
}

/// === REVENUE MANAGEMENT (Receitas com Parcelamento) ===
model Revenue {
  id              String               @id @default(uuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  description     String
  totalAmount     Float
  emissionDate    DateTime
  type            String               @default("PARCELADO")  // AVISTA | PARCELADO
  status          String               @default("EMITTED")     // EMITTED | PARTIAL | RECEIVED | CANCELLED
  categoryId      String?
  category        Category?            @relation(fields: [categoryId], references: [id])
  observations    String?
  installments    RevenueInstallment[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([userId, emissionDate])
  @@index([userId, status])
}

model RevenueInstallment {
  id          String    @id @default(uuid())
  revenueId   String
  revenue     Revenue   @relation(fields: [revenueId], references: [id], onDelete: Cascade)
  installmentNumber Int
  amount      Float
  dueDate     DateTime
  status      String    @default("PENDING")  // PENDING | RECEIVED
  receivedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  @@unique([revenueId, installmentNumber])
  @@index([revenueId, dueDate])
  @@index([status, dueDate])
}

model CashflowWeekly {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart       DateTime
  weekEnd         DateTime
  weekNumber      Int
  monthYear       String
  totalIncome     Float     @default(0)
  totalExpenses   Float     @default(0)
  receivedAmount  Float     @default(0)
  projectedAmount Float     @default(0)
  balance         Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, weekStart, monthYear])
  @@index([userId, monthYear])
}

/// === DOCUMENT IMPORT (Nota fiscal, comprovante, recibo, etc) ===
model ImportedDocument {
  id                String                      @id @default(uuid())
  userId            String
  user              User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName          String
  fileType          String
  fileSize         Int?
  fileHash         String?
  blobUrl          String?
  status           String                      @default("PENDING_REVIEW") // PENDING_REVIEW, IMPORTED, REJECTED, ERROR
  extractedData   Json?
  rawText         String?
  confidence      Float                      @default(0)
  errorMessage    String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  transactionId   String?                    @unique

  @@index([userId, status])
  @@index([userId, fileHash])
}

model DocumentImportAttempt {
  id                String   @id @default(uuid())
  userId            String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName         String
  fileType        String
  blobUrl         String?
  extractedData   Json
  proposedCategory String?
  proposedType   String?
  proposedStatus String?
  confidence    Float     @default(0)
  isDuplicate    Boolean   @default(false)
  duplicateOf   String?
  reviewedAt    DateTime?
  importedAt   DateTime?
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  rejectReason String?
  createdAt    DateTime  @default(now())

  @@index([userId, status])
}

// ===== COPILOTO RAG =====
model CopilotConversation {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Page context
  pageType      String            // DASHBOARD, ACCOUNTS, TRANSACTIONS, BUDGETS, RECURRENCES, INSIGHTS
  pageContext   Json?             // Dados da página (métricas, filtros, IDs)

  messages      CopilotMessage[]

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model CopilotMessage {
  id              String                  @id @default(uuid())
  conversationId  String
  conversation    CopilotConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role            String                  // "user" | "assistant"
  content         String                  @db.Text

  // Metadata
  sources         String[]                // RAG document IDs
  metrics         Json?                   // Métricas incluídas

  createdAt       DateTime                @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

// ===== AI AGENTS =====
model AIAgent {
  id            String              @id @default(uuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identification
  name          String              // "Revisar orçamento diariamente"
  description   String?
  type          String              // BUDGET_REVIEW, EXPENSE_ALERT, INCOME_CHECK, CASHFLOW_FORECAST, SAVINGS_GOAL, CUSTOM

  // Schedule
  schedule      String              // Cron expression: "0 8 * * *"
  isActive      Boolean             @default(true)
  timezone      String              @default("America/Sao_Paulo")

  // Configuration
  config        Json                // Type-specific config

  // Relations
  actions       AgentAction[]
  executions    AgentExecution[]

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId])
  @@index([isActive])
}

model AgentAction {
  id          String    @id @default(uuid())
  agentId     String
  agent       AIAgent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // Type
  type        String    // EMAIL, SMS, IN_APP_NOTIFICATION, WEBHOOK

  // Configuration
  recipient   String?   // Email, phone, or webhook URL
  template    String?   // Template name for rendering

  order       Int       // Execution order

  createdAt   DateTime  @default(now())

  @@unique([agentId, order])
}

model AgentExecution {
  id              String    @id @default(uuid())
  agentId         String
  agent           AIAgent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // Status
  status          String    // PENDING, RUNNING, SUCCESS, FAILED

  // Results
  output          Json?     // Insights gerados
  actionResults   Json?     // Resultado de cada ação {EMAIL: {sent: true}, ...}
  error           String?   // Error message

  // Timeline
  scheduledAt     DateTime
  startedAt       DateTime?
  completedAt     DateTime?

  createdAt       DateTime  @default(now())

  @@index([agentId])
  @@index([status])
  @@index([scheduledAt])
}

// ===== DAILY INTELLIGENCE & MINI IA =====

model UserIntelligence {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Profile & Scoring
  riskScore             Float    @default(50) // 0-100
  savingsRate           Float    @default(0)  // %
  predictabilityScore   Float    @default(50) // 0-100
  impulsivityScore      Float    @default(50) // 0-100
  behaviorChangeScore   Float    @default(0)  // 0-100
  predictionAccuracyScore Float  @default(50) // 0-100
  impactScore           Float    @default(50) // 0-100 (overall success of system)
  
  // States
  recentPatternShift    Boolean  @default(false)
  cashflowStability     Float    @default(50) // 0-100
  
  lastCalculatedAt      DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Insight {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type            String   // EXPENSE_WARNING, CASHFLOW_RISK, SAVINGS_OPP
  content         String
  templateId      String?
  template        InsightTemplate? @relation(fields: [templateId], references: [id])
  
  score           Float    @default(0) // dynamic priority
  priority        String   @default("LOW") // HIGH, MEDIUM, LOW
  impactScore     Float    @default(0) // 0-100 (actual improvement)
  
  status          String   @default("GENERATED") // GENERATED, SHOWN, ACTED, IGNORED
  
  expectedEffect  String?
  actualEffect    String?
  
  interactions    InsightInteraction[]
  
  createdAt       DateTime @default(now())
  actedAt         DateTime?
}

model Prediction {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type            String   // CASHFLOW_NEGATIVE, BUDGET_OVERRUN
  predictedDate   DateTime
  predictedAmount Float?
  
  actualDate      DateTime?
  actualAmount    Float?
  
  errorMargin     Float?
  status          String   @default("PENDING") // PENDING, VERIFIED
  
  createdAt       DateTime @default(now())
  verifiedAt      DateTime?
}

model InsightTemplate {
  id              String   @id @default(uuid())
  type            String   // matches Insight.type
  content         String   // The text template
  
  performanceScore Float   @default(50) // 0-100
  usageCount      Int      @default(0)
  actionCount     Int      @default(0)
  ignoreCount     Int      @default(0)
  
  insights        Insight[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DailyExecutionLog {
  id              String   @id @default(uuid())
  date            DateTime @default(now())
  status          String   // SUCCESS, PARTIAL_SUCCESS, FAILED
  usersProcessed  Int      @default(0)
  usersFailed     Int      @default(0)
  insightsGenerated Int    @default(0)
  agentsExecuted  Int      @default(0)
  executionTimeMs Int      @default(0)
  errors          Json?
  
  createdAt       DateTime @default(now())
}

model InsightInteraction {
  id              String   @id @default(uuid())
  insightId       String
  insight         Insight  @relation(fields: [insightId], references: [id], onDelete: Cascade)
  
  interactionType String   // VIEWED, CLICKED, DISMISSED, ACTED
  metadata        Json?    // Context at time of interaction
  
  createdAt       DateTime @default(now())
}

model UserBehavioralLog {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  changeType      String   // SPENDING_INCREASE, NEW_CATEGORY, FREQUENCY_SHIFT
  description     String?
  severity        Float    @default(0) // 0-100
  
  createdAt       DateTime @default(now())
}

model Webhook {
  id        String   @id @default(uuid())
  name      String
  url       String
  events    String[]
  secret    String?
  isActive  Boolean  @default(true)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
