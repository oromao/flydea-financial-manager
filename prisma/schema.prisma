generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                   @id @default(uuid())
  email                 String                   @unique
  password              String
  role                  String                   @default("MEMBER")
  name                  String?
  avatarUrl             String?
  createdAt             DateTime                 @default(now())
  accounts              Account[]
  auditLogs             AuditLog[]
  budgets               Budget[]
  categories            Category[]
  recurrences           Recurrence[]
  tags                  Tag[]
  transactions          Transaction[]
  notifications         Notification[]
  notificationPreference NotificationPreference?
  approvalsRequested    ApprovalRequest[]       @relation("ApprovalsRequested")
  approvalsReviewed     ApprovalRequest[]       @relation("ApprovalsReviewed")
  invoices              Invoice[]
  revenues              Revenue[]
  cashflowWeekly        CashflowWeekly[]
  importedDocuments    ImportedDocument[]
  documentImportAttempts DocumentImportAttempt[]
}

model Category {
  id           String        @id @default(uuid())
  name         String
  type         String
  createdAt    DateTime      @default(now())
  userId       String?
  budgets      Budget[]
  user         User?         @relation(fields: [userId], references: [id])
  recurrences  Recurrence[]
  transactions Transaction[]
  revenues     Revenue[]

  @@unique([name, userId])
}

model Account {
  id           String        @id @default(uuid())
  name         String
  type         String
  balance      Float         @default(0)
  color        String?
  userId       String
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id            String           @id @default(uuid())
  type          String
  description   String
  amount        Float
  date          DateTime
  dueDate       DateTime?
  paidAt        DateTime?
  amountPaid    Float            @default(0)
  recurrenceId  String?
  recurrenceDate DateTime?
  observations  String?
  frequency     String           @default("NONE")
  paymentStatus String           @default("PAID")
  attachmentUrl String?
  blobUrl       String?
  status        String           @default("CONFIRMED")
  userId        String
  categoryId    String
  accountId     String?
  createdAt     DateTime         @default(now())
  account       Account?         @relation(fields: [accountId], references: [id])
  category      Category         @relation(fields: [categoryId], references: [id])
  user          User             @relation(fields: [userId], references: [id])
  tags          TransactionTag[]
  importedDocumentId String?
}

model Tag {
  id           String           @id @default(uuid())
  name         String
  color        String           @default("#3B82F6")
  userId       String
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id])
  transactions TransactionTag[]

  @@unique([name, userId])
}

model TransactionTag {
  transactionId String
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
}

model Budget {
  id         String   @id @default(uuid())
  categoryId String
  userId     String
  amount     Float
  period     String   @default("MONTHLY")
  alertAt    Float    @default(80)
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model Recurrence {
  id          String    @id @default(uuid())
  description String
  amount      Float
  type        String    @default("EXPENSE")
  frequency   String
  startDate   DateTime
  nextDate    DateTime?
  dayOfMonth  Int?
  categoryId  String
  userId      String
  createdAt   DateTime  @default(now())
  isActive    Boolean   @default(true)
  category    Category  @relation(fields: [categoryId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  details   String?
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  message       String
  type          String
  relatedId     String?
  relatedType   String?
  metadata      Json?
  read          Boolean  @default(false)
  readAt        DateTime?
  createdAt     DateTime @default(now())
  expiresAt     DateTime?

  @@index([userId])
  @@index([createdAt])
}

model NotificationPreference {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled     Boolean @default(true)
  inAppEnabled     Boolean @default(true)
  transactionsOn   Boolean @default(true)
  budgetAlertsOn   Boolean @default(true)
  importsOn        Boolean @default(true)
  remindersOn      Boolean @default(true)
}

model ApprovalRequest {
  id          String   @id @default(cuid())
  action      String
  entity      String
  entityId    String
  payload     Json?
  status      String   @default("PENDING")
  reason      String?
  requestedById String
  reviewedById String?
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  requestedBy User     @relation("ApprovalsRequested", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User?    @relation("ApprovalsReviewed", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([entity, entityId])
}

model Invoice {
  id                String                @id @default(uuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceNumber     String
  clientName        String
  clientEmail       String?
  description       String?
  totalAmount       Float
  emissionDate      DateTime
  dueDate           DateTime?
  status            String                @default("EMITTED")
  paymentMethod     String?
  observations      String?
  installments      InvoiceInstallment[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([userId, invoiceNumber])
  @@index([userId, emissionDate])
  @@index([userId, status])
}

model InvoiceInstallment {
  id              String    @id @default(uuid())
  invoiceId       String
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  installmentNumber Int
  amount          Float
  dueDate         DateTime
  status          String    @default("PENDING")
  paidAt          DateTime?
  paidAmount      Float?
  createdAt       DateTime  @default(now())

  @@unique([invoiceId, installmentNumber])
  @@index([invoiceId, dueDate])
  @@index([status])
}

/// === REVENUE MANAGEMENT (Receitas com Parcelamento) ===
model Revenue {
  id              String               @id @default(uuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  description     String
  totalAmount     Float
  emissionDate    DateTime
  type            String               @default("PARCELADO")  // AVISTA | PARCELADO
  status          String               @default("EMITTED")     // EMITTED | PARTIAL | RECEIVED | CANCELLED
  categoryId      String?
  category        Category?            @relation(fields: [categoryId], references: [id])
  observations    String?
  installments    RevenueInstallment[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([userId, emissionDate])
  @@index([userId, status])
}

model RevenueInstallment {
  id          String    @id @default(uuid())
  revenueId   String
  revenue     Revenue   @relation(fields: [revenueId], references: [id], onDelete: Cascade)
  installmentNumber Int
  amount      Float
  dueDate     DateTime
  status      String    @default("PENDING")  // PENDING | RECEIVED
  receivedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  @@unique([revenueId, installmentNumber])
  @@index([revenueId, dueDate])
  @@index([status, dueDate])
}

model CashflowWeekly {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart       DateTime
  weekEnd         DateTime
  weekNumber      Int
  monthYear       String
  totalIncome     Float     @default(0)
  totalExpenses   Float     @default(0)
  receivedAmount  Float     @default(0)
  projectedAmount Float     @default(0)
  balance         Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, weekStart, monthYear])
  @@index([userId, monthYear])
}

/// === DOCUMENT IMPORT (Nota fiscal, comprovante, recibo, etc) ===
model ImportedDocument {
  id                String                      @id @default(uuid())
  userId            String
  user              User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName          String
  fileType          String
  fileSize         Int?
  fileHash         String?
  blobUrl          String?
  status           String                      @default("PENDING_REVIEW") // PENDING_REVIEW, IMPORTED, REJECTED, ERROR
  extractedData   Json?
  rawText         String?
  confidence      Float                      @default(0)
  errorMessage    String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  transactionId   String?                    @unique

  @@index([userId, status])
  @@index([userId, fileHash])
}

model DocumentImportAttempt {
  id                String   @id @default(uuid())
  userId            String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName         String
  fileType        String
  blobUrl         String?
  extractedData   Json
  proposedCategory String?
  proposedType   String?
  proposedStatus String?
  confidence    Float     @default(0)
  isDuplicate    Boolean   @default(false)
  duplicateOf   String?
  reviewedAt    DateTime?
  importedAt   DateTime?
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  rejectReason String?
  createdAt    DateTime  @default(now())

  @@index([userId, status])
}
