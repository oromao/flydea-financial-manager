{
    "mcpServers": {
        "vercel": {
            "command": "npx",
            "args": [
                "-y",
                "@vercel/mcp"
            ],
            "env": {
                "VERCEL_API_TOKEN": "YOUR_TOKEN_HERE"
            }
        },
        "context7": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp",
                "--api-key",
                "YOUR_API_KEY"
            ]
        },
        "shadcn": {
            "command": "npx",
            "args": [
                "shadcn@latest",
                "mcp"
            ]
        }
    }
}

// setup mcp server in  ~/.gemini\antigravity\mcp_config.json

